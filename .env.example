# Music Hit Maker Studio — Exemple de configuration (.env)
# -----------------------------------------------------------
# Copiez ce fichier → .env et complétez avec vos vraies clés.
# ⚠️ LE .env RÉEL EST GIT-IGNORÉ (jamais committre les secrets).
#
# Ce fichier .env.example est versionné pour documenter la configuration.

# === Serveur ===
PORT=3000
# URL publique de production (OBLIGATOIRE en prod : sert de base pour le
# CORS et les success_url/cancel_url Stripe). Sur Vercel, VERCEL_URL suffit.
PUBLIC_BASE_URL=https://money-maker-nnpb.vercel.app
NODE_ENV=production        # "production" active le masquage d'erreurs

# === Vercel Blob (PERSISTANCE commandes + fichiers générés) ===
# → Dashboard Vercel : Storage → Create Database → Blob (le token s'ajoute auto).
# → SANS CETTE VARIABLE, POST /api/stripe/checkout échoue (saveOrder()) !
BLOB_READ_WRITE_TOKEN=

# === Groq (génération paroles / style) ===
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# === Suno (génération musicale) — API sunoapi.org ===
SUNO_API_KEY=
SUNO_API_BASE=https://api.sunoapi.org/api/v1
SUNO_MODEL=V4

# === Udio (fallback génération musicale) — udioapi.pro ===
UDIO_API_KEY=
UDIO_API_BASE=https://udioapi.pro/api
UDIO_MODEL=chirp-v4-5

# === Nano Banana / Gemini (pochette d'album + fallback LLM) ===
BANANA_API_KEY=

# === Hugging Face (fallback génération d'image) ===
HF_API_KEY=
HF_IMAGE_MODEL=stabilityai/stable-diffusion-3-medium-diffusers

# === Stripe (« Publier en direct » = 1,99 € one-shot) ===
# Le prix est créé INLINE à la volée via price_data (pas de price_id stocké).
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_EUR=1.99
# ⚠️ Webhook à configurer dans Dashboard Stripe → Developers → Webhooks :
#   URL : https://<votre-app>.vercel.app/api/stripe/webhook
#   Événement : checkout.session.completed

# === Mode automatique (cron quotidien) — APIs Suno/Udio sont PAYANTES ===
# Le pipeline auto est DÉSACTIVÉ par défaut (AUTO_ENABLED=false).
AUTO_ENABLED=false

# === Facebook (Page « Music hit maker ») ===
FB_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=1309437248912521

# === Instagram (Graph API — compte pro lié à la page FB) ===
INSTAGRAM_ACCOUNT_ID=17841436299535102
INSTAGRAM_ACCESS_TOKEN=

# === Optionnel : notification Discord du hit du jour ===
DISCORD_WEBHOOK_URL=
